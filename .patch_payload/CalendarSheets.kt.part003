                color = colors.surface,
                border = BorderStroke(1.dp, colors.outline),
            ) {
                Row(
                    modifier = Modifier.padding(start = 13.dp, end = 4.dp),
                    verticalAlignment = Alignment.CenterVertically,
                ) {
                    Icon(
                        imageVector = Icons.Default.Search,
                        contentDescription = null,
                        tint = colors.tertiaryInk,
                        modifier = Modifier.size(20.dp),
                    )
                    BasicTextField(
                        value = query,
                        onValueChange = { query = it },
                        modifier = Modifier
                            .weight(1f)
                            .padding(horizontal = 10.dp),
                        textStyle = TextStyle(color = colors.ink, fontSize = 14.sp),
                        cursorBrush = SolidColor(colors.brand),
                        singleLine = true,
                        decorationBox = { inner ->
                            if (query.isBlank()) {
                                Text("搜索标题或描述", color = colors.tertiaryInk, fontSize = 14.sp)
                            }
                            inner()
                        },
                    )
                    if (query.isNotEmpty()) {
                        LuluIconButton(
                            icon = Icons.Default.Close,
                            contentDescription = "清空搜索",
                            onClick = { query = "" },
                        )
                    }
                }
            }
            Text(
                text = if (query.isBlank()) "输入关键词开始搜索" else "${results.size} 条结果",
                color = colors.tertiaryInk,
                fontSize = 12.sp,
                modifier = Modifier.padding(horizontal = 18.dp, vertical = 14.dp),
            )
            when {
                query.isBlank() -> SearchEmptyState(message = "搜索日程标题、描述与子任务")
                results.isEmpty() -> SearchEmptyState(message = "没有找到相关安排")
                else -> LazyColumn(
                    modifier = Modifier.fillMaxSize(),
                    contentPadding = PaddingValues(start = 16.dp, end = 16.dp, bottom = 24.dp),
                    verticalArrangement = Arrangement.spacedBy(9.dp),
                ) {
                    items(results, key = { it.uuid }) { task ->
                        CalendarTaskCard(
                            task = task,
                            date = task.start.toLocalDate(),
                            onClick = { onOpen(task) },
                            onToggleCompletion = { completed ->
                                onToggleCompletion(task, task.start.toLocalDate(), completed)
                            },
                            onTogglePin = { onTogglePin(task) },
                        )
                    }
                }
            }
        }
    }
}

@Composable
private fun SearchEmptyState(message: String) {
    val colors = LuluCalendarTheme.colors
    Column(
        modifier = Modifier
            .fillMaxWidth()
            .padding(top = 36.dp),
        horizontalAlignment = Alignment.CenterHorizontally,
    ) {
        Surface(
            modifier = Modifier.size(68.dp),
            shape = RoundedCornerShape(24.dp),
            color = colors.brandSoft,
            contentColor = colors.brand,
        ) {
            Box(contentAlignment = Alignment.Center) {
                Icon(Icons.Default.Search, null, modifier = Modifier.size(34.dp))
            }
        }
        Text(
            text = message,
            color = colors.secondaryInk,
            fontSize = 13.sp,
            modifier = Modifier.padding(top = 12.dp),
        )
    }
}

@Composable
fun DeleteCalendarTaskDialog(
    task: CalendarTaskItem,
    onDismiss: () -> Unit,
    onConfirm: () -> Unit,
) {
    val colors = LuluCalendarTheme.colors
    AlertDialog(
        onDismissRequest = onDismiss,
        icon = {
            Surface(
                modifier = Modifier.size(48.dp),
                shape = RoundedCornerShape(16.dp),
                color = colors.dangerSoft,
                contentColor = colors.danger,
            ) {
                Box(contentAlignment = Alignment.Center) {
                    Icon(Icons.Default.Delete, null, modifier = Modifier.size(25.dp))
                }
            }
        },
        title = { Text("删除这项日程？", fontWeight = FontWeight.Bold) },
        text = {
            Text(
                text = "“${task.title}”将从日历中移除，此操作无法撤销。",
                color = colors.secondaryInk,
                lineHeight = 20.sp,
            )
        },
        confirmButton = {
            TextButton(onClick = onConfirm) {
                Text("删除", color = colors.danger, fontWeight = FontWeight.Bold)
            }
        },
        dismissButton = {
            TextButton(onClick = onDismiss) {
                Text("取消", color = colors.secondaryInk, fontWeight = FontWeight.SemiBold)
            }
        },
        shape = RoundedCornerShape(24.dp),
        containerColor = colors.surface,
        titleContentColor = colors.ink,
    )
}

@Composable
private fun LuluBottomSheet(
    title: String,
    onDismiss: () -> Unit,
    footer: @Composable (() -> Unit)? = null,
    content: @Composable () -> Unit,
) {
    val colors = LuluCalendarTheme.colors
    Dialog(
        onDismissRequest = onDismiss,
        properties = DialogProperties(
            usePlatformDefaultWidth = false,
            decorFitsSystemWindows = false,
        ),
    ) {
        Box(
            modifier = Modifier
                .fillMaxSize()
                .background(Color.Black.copy(alpha = .36f))
                .clickable(onClick = onDismiss),
            contentAlignment = Alignment.BottomCenter,
        ) {
            Surface(
                modifier = Modifier
                    .fillMaxWidth()
                    .fillMaxHeight(.90f)
                    .clickable(onClick = {}),
                shape = RoundedCornerShape(topStart = 28.dp, topEnd = 28.dp),
                color = colors.canvas,
                contentColor = colors.ink,
            ) {
                Column(modifier = Modifier.fillMaxSize()) {
                    Box(
                        modifier = Modifier
                            .align(Alignment.CenterHorizontally)
                            .padding(top = 9.dp, bottom = 4.dp)
                            .width(38.dp)
                            .height(4.dp)
                            .background(colors.outline, RoundedCornerShape(50)),
                    )
                    Row(
                        modifier = Modifier
                            .fillMaxWidth()
                            .height(58.dp)
                            .padding(start = 16.dp, end = 8.dp),
                        verticalAlignment = Alignment.CenterVertically,
                    ) {
                        Text(
                            text = title,
                            color = colors.ink,
                            fontSize = 18.sp,
                            fontWeight = FontWeight.Bold,
                            modifier = Modifier.weight(1f),
                        )
                        LuluIconButton(Icons.Default.Close, "关闭", onDismiss)
                    }
                    Divider(color = colors.divider)
                    LazyColumn(
                        modifier = Modifier.weight(1f),
                        contentPadding = PaddingValues(16.dp),
                    ) {
                        item { content() }
                    }
                    if (footer != null) {
                        Divider(color = colors.divider)
                        footer()
                    }
                }
            }
        }
    }
}

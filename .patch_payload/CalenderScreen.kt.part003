    val today = LocalDate.now()
    return remember(today) {
        listOf(
            CalendarTaskItem(
                id = 1,
                title = "完成 LuluCalendar 视觉复检",
                description = "逐页核对色彩、间距、圆角与交互状态，整理最终自检报告。",
                start = LocalDateTime.of(today, LocalTime.of(9, 30)),
                end = LocalDateTime.of(today, LocalTime.of(11, 0)),
                isPinned = true,
                quadrant = 1,
                colorHex = "#CF3E70",
            ),
            CalendarTaskItem(
                id = 2,
                title = "产品例会",
                description = "同步本周日历体验与编辑器交互。",
                start = LocalDateTime.of(today, LocalTime.of(14, 0)),
                end = LocalDateTime.of(today, LocalTime.of(15, 0)),
                quadrant = 3,
                colorHex = "#6287C5",
            ),
        )
    }
}

private val MonthTitleFormatter = DateTimeFormatter.ofPattern("yyyy年M月")
private val TimelineFormatter = DateTimeFormatter.ofPattern("HH:mm")

@Composable
fun CalenderScreen(
    tasks: List<CalendarTaskItem>,
    onTaskAction: (CalendarTaskAction) -> Unit,
    onBack: () -> Unit,
    modifier: Modifier = Modifier,
    initialMode: CalendarViewMode = CalendarViewMode.MONTH,
    darkTheme: Boolean? = null,
) {
    LuluCalendarDesignTheme(darkTheme = darkTheme ?: androidx.compose.foundation.isSystemInDarkTheme()) {
        val today = remember { LocalDate.now() }
        var selectedDate by remember { mutableStateOf(today) }
        var visibleMonth by remember { mutableStateOf(YearMonth.from(today)) }
        var mode by remember { mutableStateOf(initialMode) }
        var filter by remember { mutableStateOf(CalendarAgendaFilter()) }
        var filterOpen by remember { mutableStateOf(false) }
        var searchOpen by remember { mutableStateOf(false) }
        var editor by remember { mutableStateOf<CalendarEditorState?>(null) }
        var detailTask by remember { mutableStateOf<CalendarTaskItem?>(null) }
        var deleteTask by remember { mutableStateOf<CalendarTaskItem?>(null) }

        val selectedDayTasks = remember(tasks, selectedDate) { tasks.forCalendarDate(selectedDate) }
        BackHandler(enabled = searchOpen || editor != null) {
            when {
                editor != null -> editor = null
                searchOpen -> searchOpen = false
            }
        }

        Surface(
            modifier = modifier.fillMaxSize(),
            color = LuluCalendarTheme.colors.canvas,
            contentColor = LuluCalendarTheme.colors.ink,
        ) {
            Box(modifier = Modifier.fillMaxSize()) {
                Column(modifier = Modifier.fillMaxSize()) {
                    CalendarTopBar(
                        visibleMonth = visibleMonth,
                        onBack = onBack,
                        onToday = {
                            selectedDate = today
                            visibleMonth = YearMonth.from(today)
                        },
                        onSearch = { searchOpen = true },
                    )
                    LuluSegmentedControl(
                        selected = mode,
                        onSelect = { mode = it },
                        modifier = Modifier.padding(
                            start = LuluCalendarDimens.screenHorizontal,
                            end = LuluCalendarDimens.screenHorizontal,
                            bottom = 12.dp,
                        ),
                    )
                    when (mode) {
                        CalendarViewMode.MONTH -> MonthCalendarContent(
                            visibleMonth = visibleMonth,
                            selectedDate = selectedDate,
                            today = today,
                            tasks = tasks,
                            filter = filter,
                            onMonthChange = { visibleMonth = it },
                            onDateSelected = { selectedDate = it },
                            onFilterChange = { filter = it },
                            onFilterClick = { filterOpen = true },
                            onCreate = { editor = newEditorState(selectedDate) },
                            onOpen = { detailTask = it },
                            onToggleCompletion = { task, completed ->
                                onTaskAction(
                                    CalendarTaskAction.ToggleCompletion(
                                        taskId = task.id,
                                        date = selectedDate,
                                        completed = completed,
                                    ),
                                )
                            },
                            onTogglePin = { onTaskAction(CalendarTaskAction.TogglePin(it.id)) },
                        )
                        CalendarViewMode.WEEK -> WeekCalendarContent(
                            selectedDate = selectedDate,
                            tasks = tasks,
                            onDateSelected = {
                                selectedDate = it
                                visibleMonth = YearMonth.from(it)
                            },
                            onOpen = { detailTask = it },
                            onCreate = { editor = newEditorState(selectedDate) },
                        )
                        CalendarViewMode.AGENDA -> AgendaPanel(
                            selectedDate = selectedDate,
                            tasks = tasks,
                            filter = filter,
                            onFilterChange = { filter = it },
                            onFilterClick = { filterOpen = true },
                            onCreate = { editor = newEditorState(selectedDate) },
                            onOpen = { detailTask = it },
                            onToggleCompletion = { task, completed ->
                                onTaskAction(
                                    CalendarTaskAction.ToggleCompletion(
                                        taskId = task.id,
                                        date = selectedDate,
                                        completed = completed,
                                    ),
                                )
                            },
                            onTogglePin = { onTaskAction(CalendarTaskAction.TogglePin(it.id)) },
                            showQuickFilters = true,
                            modifier = Modifier.padding(
                                start = LuluCalendarDimens.screenHorizontal,
                                end = LuluCalendarDimens.screenHorizontal,
                            ),
                        )
                    }
                }

                if (searchOpen) {
                    CalendarSearchScreen(
                        tasks = tasks,
                        onDismiss = { searchOpen = false },
                        onOpen = {
                            detailTask = it
                            searchOpen = false
                        },
                        onToggleCompletion = { task, date, completed ->
                            onTaskAction(
                                CalendarTaskAction.ToggleCompletion(
                                    taskId = task.id,
                                    date = date,
                                    completed = completed,
                                ),
                            )
                        },
                        onTogglePin = { task ->
                            onTaskAction(CalendarTaskAction.TogglePin(task.id))
                        },
                    )
                }

                editor?.let { current ->
                    CalendarTaskEditor(
                        state = current,
                        onStateChange = { editor = it },
                        onDismiss = { editor = null },
                        onSave = { saved ->
                            val task = saved.toTask()
                            onTaskAction(
                                if (task.id == 0L) CalendarTaskAction.Create(task)
                                else CalendarTaskAction.Update(task),
                            )
                            selectedDate = task.start.toLocalDate()
                            visibleMonth = YearMonth.from(selectedDate)
                            editor = null
                        },
                    )
                }
            }

            if (filterOpen) {
                CalendarFilterSheet(
                    current = filter,
                    tasks = tasks,
                    selectedDate = selectedDate,
                    onApply = { filter = it },
                    onDismiss = { filterOpen = false },
                )
            }

            detailTask?.let { task ->
                CalendarTaskDetailSheet(
                    task = task,
                    selectedDate = selectedDate,
                    onDismiss = { detailTask = null },
                    onEdit = {
                        editor = CalendarEditorState.fromTask(task)
                        detailTask = null
                    },
                    onDelete = {

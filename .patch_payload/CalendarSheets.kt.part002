    task: CalendarTaskItem,
    selectedDate: LocalDate,
    onDismiss: () -> Unit,
    onEdit: () -> Unit,
    onDelete: () -> Unit,
    onTogglePin: () -> Unit,
    onToggleSubtask: (String, Boolean) -> Unit,
) {
    val colors = LuluCalendarTheme.colors
    val accent = parseCalendarColor(task.colorHex)
    LuluBottomSheet(
        title = "日程详情",
        onDismiss = onDismiss,
        footer = {
            Row(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(start = 16.dp, end = 16.dp, top = 10.dp, bottom = 20.dp),
                horizontalArrangement = Arrangement.spacedBy(10.dp),
            ) {
                LuluSecondaryButton(
                    text = "删除",
                    icon = Icons.Default.Delete,
                    danger = true,
                    onClick = onDelete,
                    modifier = Modifier.weight(1f),
                )
                LuluPrimaryButton(
                    text = "编辑",
                    icon = Icons.Default.Edit,
                    onClick = onEdit,
                    modifier = Modifier.weight(1f),
                )
            }
        },
    ) {
        Row(verticalAlignment = Alignment.Top) {
            Box(
                modifier = Modifier
                    .width(5.dp)
                    .height(70.dp)
                    .background(accent, RoundedCornerShape(5.dp)),
            )
            Column(
                modifier = Modifier
                    .weight(1f)
                    .padding(start = 12.dp),
            ) {
                Text(
                    text = task.title,
                    color = colors.ink,
                    fontSize = 21.sp,
                    lineHeight = 28.sp,
                    fontWeight = FontWeight.Bold,
                )
                if (task.description.isNotBlank()) {
                    Text(
                        text = task.description,
                        color = colors.secondaryInk,
                        fontSize = 13.sp,
                        lineHeight = 20.sp,
                        modifier = Modifier.padding(top = 7.dp),
                    )
                }
            }
            LuluIconButton(
                icon = Icons.Default.PushPin,
                contentDescription = if (task.isPinned) "取消置顶" else "置顶",
                onClick = onTogglePin,
                filled = true,
            )
        }
        Row(
            modifier = Modifier.padding(top = 18.dp),
            horizontalArrangement = Arrangement.spacedBy(9.dp),
        ) {
            DetailInfoTile(
                label = "日期",
                value = selectedDate.format(DetailDateFormatter),
                modifier = Modifier.weight(1f),
            )
            DetailInfoTile(
                label = "时间",
                value = if (task.allDay) "全天" else "${task.start.toLocalTime().format(DetailTimeFormatter)}–${task.end.toLocalTime().format(DetailTimeFormatter)}",
                modifier = Modifier.weight(1f),
            )
        }
        Row(
            modifier = Modifier.padding(top = 9.dp),
            horizontalArrangement = Arrangement.spacedBy(9.dp),
        ) {
            DetailInfoTile(
                label = "提醒",
                value = if (task.reminders.isEmpty()) "未设置" else "${task.reminders.size} 个提醒",
                modifier = Modifier.weight(1f),
            )
            DetailInfoTile(
                label = "分类",
                value = quadrantLabel(task.quadrant),
                modifier = Modifier.weight(1f),
            )
        }
        if (task.subtasks.isNotEmpty()) {
            Text(
                text = "子任务 · ${task.completedSubtasks}/${task.subtasks.size}",
                color = colors.ink,
                fontSize = 13.sp,
                fontWeight = FontWeight.Bold,
                modifier = Modifier.padding(top = 18.dp, bottom = 8.dp),
            )
            Column(verticalArrangement = Arrangement.spacedBy(7.dp)) {
                task.subtasks.forEach { subtask ->
                    Surface(
                        modifier = Modifier.fillMaxWidth(),
                        shape = RoundedCornerShape(13.dp),
                        color = colors.surface,
                        border = BorderStroke(1.dp, colors.outline),
                        onClick = { onToggleSubtask(subtask.id, !subtask.completed) },
                    ) {
                        Row(
                            modifier = Modifier
                                .fillMaxWidth()
                                .height(46.dp)
                                .padding(horizontal = 10.dp),
                            verticalAlignment = Alignment.CenterVertically,
                        ) {
                            Surface(
                                modifier = Modifier.size(24.dp),
                                shape = RoundedCornerShape(7.dp),
                                color = if (subtask.completed) colors.brand else Color.Transparent,
                                contentColor = Color.White,
                                border = BorderStroke(1.7.dp, colors.brand),
                            ) {
                                if (subtask.completed) {
                                    Icon(Icons.Default.Check, null, modifier = Modifier.padding(4.dp))
                                }
                            }
                            Text(
                                text = subtask.title,
                                color = if (subtask.completed) colors.tertiaryInk else colors.ink,
                                fontSize = 12.sp,
                                maxLines = 1,
                                overflow = TextOverflow.Ellipsis,
                                modifier = Modifier.padding(start = 9.dp),
                            )
                        }
                    }
                }
            }
        }
    }
}

@Composable
private fun DetailInfoTile(
    label: String,
    value: String,
    modifier: Modifier = Modifier,
) {
    val colors = LuluCalendarTheme.colors
    Surface(
        modifier = modifier.height(74.dp),
        shape = RoundedCornerShape(16.dp),
        color = colors.surface,
        border = BorderStroke(1.dp, colors.outline),
    ) {
        Column(modifier = Modifier.padding(horizontal = 12.dp, vertical = 11.dp)) {
            Text(label, color = colors.tertiaryInk, fontSize = 10.sp)
            Text(
                value,
                color = colors.ink,
                fontSize = 13.sp,
                lineHeight = 18.sp,
                fontWeight = FontWeight.Bold,
                modifier = Modifier.padding(top = 6.dp),
                maxLines = 2,
                overflow = TextOverflow.Ellipsis,
            )
        }
    }
}

@Composable
fun CalendarSearchScreen(
    tasks: List<CalendarTaskItem>,
    onDismiss: () -> Unit,
    onOpen: (CalendarTaskItem) -> Unit,
    onToggleCompletion: (CalendarTaskItem, LocalDate, Boolean) -> Unit,
    onTogglePin: (CalendarTaskItem) -> Unit,
) {
    val colors = LuluCalendarTheme.colors
    var query by remember { mutableStateOf("") }
    val results = remember(tasks, query) { tasks.searchCalendarTasks(query) }
    Surface(
        modifier = Modifier.fillMaxSize(),
        color = colors.canvas,
        contentColor = colors.ink,
    ) {
        Column(modifier = Modifier.fillMaxSize()) {
            Row(
                modifier = Modifier
                    .fillMaxWidth()
                    .height(64.dp)
                    .padding(start = 8.dp, end = 12.dp),
                verticalAlignment = Alignment.CenterVertically,
            ) {
                LuluIconButton(Icons.Default.Close, "关闭搜索", onDismiss)
                Text(
                    text = "搜索",
                    fontSize = 18.sp,
                    fontWeight = FontWeight.Bold,
                    modifier = Modifier.padding(start = 1.dp),
                )
            }
            Surface(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(horizontal = 16.dp)
                    .height(50.dp),
                shape = RoundedCornerShape(17.dp),

private val DetailTimeFormatter = DateTimeFormatter.ofPattern("HH:mm")

@Composable
fun CalendarFilterSheet(
    current: CalendarAgendaFilter,
    tasks: List<CalendarTaskItem>,
    selectedDate: LocalDate,
    onApply: (CalendarAgendaFilter) -> Unit,
    onDismiss: () -> Unit,
) {
    var draft by remember(current) { mutableStateOf(current) }
    val count = remember(tasks, selectedDate, draft) {
        tasks.applyAgendaFilter(selectedDate, draft).size
    }
    LuluBottomSheet(
        title = "筛选日程",
        onDismiss = onDismiss,
        footer = {
            Row(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(start = 16.dp, end = 16.dp, top = 10.dp, bottom = 20.dp),
                horizontalArrangement = Arrangement.spacedBy(10.dp),
            ) {
                LuluSecondaryButton(
                    text = "重置",
                    onClick = { draft = CalendarAgendaFilter() },
                    modifier = Modifier.weight(1f),
                )
                LuluPrimaryButton(
                    text = "查看 $count 项",
                    onClick = {
                        onApply(draft)
                        onDismiss()
                    },
                    modifier = Modifier.weight(1f),
                )
            }
        },
    ) {
        FilterChoiceSection(
            title = "状态",
            choices = listOf(
                AgendaStatusFilter.ALL to "全部",
                AgendaStatusFilter.INCOMPLETE to "未完成",
                AgendaStatusFilter.COMPLETED to "已完成",
                AgendaStatusFilter.PINNED to "仅置顶",
            ),
            selected = draft.status,
            onSelected = { draft = draft.copy(status = it) },
        )
        Spacer(modifier = Modifier.height(18.dp))
        QuadrantFilterSection(
            selected = draft.quadrant,
            onSelected = { draft = draft.copy(quadrant = it) },
        )
    }
}

@Composable
private fun FilterChoiceSection(
    title: String,
    choices: List<Pair<AgendaStatusFilter, String>>,
    selected: AgendaStatusFilter,
    onSelected: (AgendaStatusFilter) -> Unit,
) {
    Text(
        text = title,
        color = LuluCalendarTheme.colors.tertiaryInk,
        fontSize = 12.sp,
        fontWeight = FontWeight.SemiBold,
        modifier = Modifier.padding(start = 2.dp, bottom = 9.dp),
    )
    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
        choices.chunked(2).forEach { rowChoices ->
            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                rowChoices.forEach { (value, label) ->
                    FilterChoice(
                        label = label,
                        selected = selected == value,
                        onClick = { onSelected(value) },
                        modifier = Modifier.weight(1f),
                    )
                }
                if (rowChoices.size == 1) Spacer(modifier = Modifier.weight(1f))
            }
        }
    }
}

@Composable
private fun QuadrantFilterSection(
    selected: Int?,
    onSelected: (Int?) -> Unit,
) {
    Text(
        text = "四象限",
        color = LuluCalendarTheme.colors.tertiaryInk,
        fontSize = 12.sp,
        fontWeight = FontWeight.SemiBold,
        modifier = Modifier.padding(start = 2.dp, bottom = 9.dp),
    )
    val choices = listOf<Int?>(null, 1, 2, 4)
    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
        choices.chunked(2).forEach { rowChoices ->
            Row(horizontalArrangement = Arrangement.spacedBy(8.dp)) {
                rowChoices.forEach { value ->
                    FilterChoice(
                        label = value?.let(::quadrantLabel) ?: "全部象限",
                        selected = selected == value,
                        onClick = { onSelected(value) },
                        modifier = Modifier.weight(1f),
                    )
                }
            }
        }
    }
}

@Composable
private fun FilterChoice(
    label: String,
    selected: Boolean,
    onClick: () -> Unit,
    modifier: Modifier = Modifier,
) {
    val colors = LuluCalendarTheme.colors
    Surface(
        modifier = modifier.height(48.dp),
        shape = RoundedCornerShape(14.dp),
        color = if (selected) colors.brandSoft else colors.surface,
        contentColor = if (selected) colors.brandStrong else colors.ink,
        border = BorderStroke(1.dp, if (selected) colors.brand.copy(alpha = .36f) else colors.outline),
        onClick = onClick,
    ) {
        Row(
            modifier = Modifier.padding(horizontal = 12.dp),
            verticalAlignment = Alignment.CenterVertically,
            horizontalArrangement = Arrangement.SpaceBetween,
        ) {
            Text(label, fontSize = 13.sp, fontWeight = FontWeight.SemiBold)
            Surface(
                modifier = Modifier.size(19.dp),
                shape = CircleShape,
                color = Color.Transparent,
                border = BorderStroke(1.5.dp, if (selected) colors.brand else colors.outline),
            ) {
                if (selected) {
                    Box(contentAlignment = Alignment.Center) {
                        Box(
                            modifier = Modifier
                                .size(9.dp)
                                .background(colors.brand, CircleShape),
                        )
                    }
                }
            }
        }
    }
}

